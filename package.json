{
  "name": "@mnml-tools/ui",
  "version": "0.1.0",
  "private": false,
  "description": "Shared tokens, styles and React components for mnml-tools desktop apps (Tauri, TypeScript, React).",
  "keywords": [
    "mnml-tools",
    "ui",
    "react",
    "tauri",
    "design-tokens",
    "css"
  ],
  "license": "UNLICENSED",
  "homepage": "https://github.com/mnml-tools/ui-kit#readme",
  "bugs": {
    "url": "https://github.com/mnml-tools/ui-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnml-tools/ui-kit.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tauri": {
      "types": "./dist/tauri/index.d.ts",
      "default": "./dist/tauri/index.js"
    },
    "./tokens.css": "./dist/styles/tokens.css",
    "./base.css": "./dist/styles/base.css",
    "./components.css": "./dist/styles/components.css",
    "./styles.css": "./dist/styles/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rm -rf dist/styles && cp -r src/styles dist/styles",
    "dev": "vite --config playground/vite.config.ts playground --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "format": "prettier --write src tests playground docs README.md",
    "format:check": "prettier --check src tests playground docs README.md",
    "prepare": "npm run clean && npm run build",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-process": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "lucide-react": ">=0.468.0",
    "react": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    },
    "@tauri-apps/plugin-process": {
      "optional": true
    },
    "@tauri-apps/plugin-updater": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "lucide-react": "^0.468.0",
    "prettier": "^3.9.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
