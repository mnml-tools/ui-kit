{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "paths": {
      "@mnml-tools/ui": ["./src/index.ts"],
      "@mnml-tools/ui/tauri": ["./src/tauri/index.ts"],
      "~/theme": ["./playground/app/theme.ts"]
    }
  },
  "include": ["src", "playground"],
  "exclude": ["playground/vite.config.ts", "playground/api-plugin.ts"]
}
